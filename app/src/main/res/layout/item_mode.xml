<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:layout_marginTop="12dp">

    <ImageView
        android:id="@+id/mode_card_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/thumb_focus"
        android:scaleType="centerCrop"
        android:contentDescription="Mode thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">
        <TextView
            android:id="@+id/mode_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Mode"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/mode_card_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay sharp &amp; productive"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/mode_card_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 min • Gamma 40 Hz"
            android:textColor="@color/blue_light"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mode_card_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_button"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="Play" />
</LinearLayout>
