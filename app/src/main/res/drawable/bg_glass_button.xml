<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass: translucent light-blue/white body, bright white edge,
     glossy highlight on the top half. Android has no true backdrop blur
     in plain XML, so glass is simulated with translucency + highlight. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#59C7E8FF" android:centerColor="#2EB0C8FF" android:endColor="#14FFFFFF" android:type="linear" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
